{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'syndic') || (!data.exists())"
      }
    },

    "notices": {
      ".read": "auth != null",
      "$noticeId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'syndic'"
      }
    },

    "events": {
      ".read": "auth != null",
      "$eventId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'syndic'"
      }
    },

    "spaces": {
      ".read": "auth != null",
      "$spaceId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'syndic'"
      }
    },

    "reservations": {
      ".read": "auth != null",
      "$reservationId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'active'"
      }
    },

    "visitors": {
      ".read": "auth != null",
      "$visitorId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'syndic' || root.child('users').child(auth.uid).child('role').val() === 'gatekeeper')"
      }
    },

    "votings": {
      ".read": "auth != null",
      "$votingId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'active'"
      }
    },

    "logs": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'syndic'",
      "$logId": {
        ".write": "auth != null"
      }
    },

    "blocks": {
      ".read": true,
      "$blockId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'syndic'"
      }
    },

    "apartments": {
      ".read": true,
      "$apartmentId": {
        ".write": "auth != null"
      }
    }
  }
}
